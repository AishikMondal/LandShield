# ---------------------------------------------------------------------------
# LandShield backend configuration (all optional — the app runs with defaults)
# ---------------------------------------------------------------------------

# Comma-separated CORS allow-list for the Vite dev server / built frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# UI-only flag; does not fake any data.
LANDSHIELD_DEMO_MODE=false

# Experimental 4-input fusion requires the missing Model-4 spatial-vulnerability
# input. When true, an explicit GIS exposure proxy is substituted and the
# response marks the basis as experimental. OFF by default — never silent.
ENABLE_EXPERIMENTAL_FUSION=false

# Model 2's original class is not shipped, only its state dict. Setting this
# enables a reconstructed inference path; treat outputs with extra caution.
ENABLE_RECONSTRUCTED_MODEL2=false

# Alert activation threshold (risk score 0-100). MODERATE starts at 25, HIGH at
# 55, CRITICAL at 80 in this build's RISK_THRESHOLDS.
ALERT_THRESHOLD=55
ALERT_COOLDOWN_MINUTES=30

# Network behaviour
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRIES=2
# Hard cap for the OSM/Overpass surroundings fetch (it fans out across mirrors).
OVERVIEW_OVERALL_TIMEOUT_SECONDS=35

# Nominatim requires a real browser-like User-Agent (plain programmatic UAs get
# HTTP 403). Keep the "Mozilla/5.0" prefix.
LANDSHIELD_USER_AGENT=Mozilla/5.0 LandShield-SIH/1.0 (prototype; contact: your-email@example.com)

# Optional Overpass mirror list (comma-separated). First responsive mirror with
# real elements wins; unhealthy mirrors are blacklisted for 30 s.
OVERPASS_ENDPOINTS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.osm.ch/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Optional live-data integrations. All degrade gracefully when absent:
# OPENWEATHER_API_KEY=        # cross-check for Open-Meteo primary weather
# SMS_PROVIDER=               # e.g. twilio / textlocal (adapter required)
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# COPERNICUS_CLIENT_ID=       # NDVI / vegetation coverage (Copernicus DT API)
# COPERNICUS_CLIENT_SECRET=